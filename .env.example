# Copy to .env on the HPC, replace /approved/storage, then: source .env
# Laptop/cloud checkouts use synthetic fixtures; these paths require HPC access.
export MPOWER_DATA_ROOT=/approved/storage/pd_data/mpower
export MPOWER_OUTPUT_ROOT=/approved/storage/pd_data/mpower_phase1
export MPOWER_BENCHMARK_ROOT=/approved/storage/pd_data/mpower_benchmarks
export MPOWER_SLURM_ROOT=/approved/storage/pd_data/slurm
export MPOWER_PYTHON=/approved/storage/pd_data/environments/mpower_venv/bin/python
export MPOWER_BENCHMARK_PYTHON=/approved/storage/pd_data/environments/benchmark_venv/bin/python
# Optional public checkpoint download location on HPC. Local downloads default
# to the Git-ignored models/ directory when MPOWER_MODEL_ROOT is unset.
export MPOWER_MODEL_ROOT="$MPOWER_BENCHMARK_ROOT/models"
# Optional absolute Python executable for the public checkpoint download job.
# export MPOWER_DOWNLOAD_PYTHON=/approved/storage/pd_data/environments/pd_env/bin/python3
# Optional for preprocessing workers; otherwise leave unset.
# export MPOWER_ENV_ARCHIVE=/approved/storage/pd_data/environments/mpower_phase1_environment.tar.gz
